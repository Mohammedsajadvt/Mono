# Mono Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with production credentials to Git!

PORT=3000

# TiDB Cloud / MySQL Database Configuration
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=mono_db
DB_SSL=true

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=your_admin_initial_password

# Firebase Authentication & FCM
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=mono-f7e35
FIREBASE_AUTH_DOMAIN=mono-f7e35.firebaseapp.com

# OneSignal Push Notification Service
ONESIGNAL_APP_ID=16a3ff7b-91c2-4b03-9c56-409c5fee91b6
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here

